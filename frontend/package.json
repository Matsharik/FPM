{
  "name": "fpm-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
        "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:money": "node scripts/check-money.mjs",
    "gen:types": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "shots": "node scripts/shots.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:money && npm run build && npm run check:money",
    "scenario": "node scripts/scenario.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
